{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greenluma Manager Next By Harman",
  "version": "1.0.1",
  "identifier": "app.gl-manager.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Greenluma Manager Next By Harman - 1.0.1",
        "width": 1240,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["English", "Turkish", "SimpChinese", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
